            "Texture.v3"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.variants[q.property('bc:variant')]"
      ]
    }
  }
}
