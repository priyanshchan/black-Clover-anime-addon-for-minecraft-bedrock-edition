{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:mana_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/soft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 40,
        "max_particles": 200
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.25
      },
      "minecraft:emitter_shape_disc": {
        "radius": "0.6 * v.sc",
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9 * (0.7 + v.particle_random_1 * 0.6)"
      },
      "minecraft:particle_initial_speed": "1.2 * (0.6 + v.particle_random_2 * 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)",
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1.0) * 1.0",
          "(v.color.g ?? 1.0) * 1.0",
          "(v.color.b ?? 1.0) * 1.0",
          "math.clamp(v.particle_age * 8.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 4.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
