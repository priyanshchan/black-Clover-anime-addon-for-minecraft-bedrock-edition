{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:magic_circle",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/circle"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sz = v.size ?? 1.6;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.9"
      },
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 120
      },
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * (0.4 + 0.6 * math.min(v.particle_age * 7.0, 1.0))",
          "v.sz * (0.4 + 0.6 * math.min(v.particle_age * 7.0, 1.0))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x ?? 0",
            "v.dir.y ?? 0",
            "v.dir.z ?? 1"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 1.0) * 1.0",
          "(v.color.g ?? 1.0) * 1.0",
          "(v.color.b ?? 1.0) * 1.0",
          "math.clamp(v.particle_age * 8.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 4.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
