{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_signal_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bc/v9/smoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "1.2",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ],
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "4.0 + v.particle_random_1 * 1.5"
      },
      "minecraft:particle_initial_speed": "5.0 + v.particle_random_2 * 2.5",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.4,
          0
        ],
        "linear_drag_coefficient": 0.25
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-20, 20)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.4 + v.particle_age / v.particle_lifetime * 2.6",
          "1.4 + v.particle_age / v.particle_lifetime * 2.6"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              0,
              64
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 0.3) * 0.6",
          "(v.color.g ?? 0.28) * 0.6",
          "(v.color.b ?? 0.26) * 0.6",
          "0.55 * math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
