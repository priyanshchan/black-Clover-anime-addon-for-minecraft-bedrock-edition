{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_trail_star",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/star"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.fk ?? 0) == 8 ? 26 : 0",
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 0
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + v.particle_random_1 * 0.4"
      },
      "minecraft:particle_initial_speed": 0.7,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-180, 180)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.09 * (0.6 + math.sin(v.particle_age * 1600.0 + v.particle_random_4 * 360.0) * 0.4)",
          "0.09 * (0.6 + math.sin(v.particle_age * 1600.0 + v.particle_random_4 * 360.0) * 0.4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, v.tr ?? 1.0, 0.5)",
          "math.lerp(1.0, v.tg ?? 1.0, 0.5)",
          "math.lerp(1.0, v.tb ?? 1.0, 0.5)",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.12,
        "direction": "outwards",
        "surface_only": false
      }
    }
  }
}
