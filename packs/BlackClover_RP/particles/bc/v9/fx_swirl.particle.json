{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_swirl",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/wisp"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 34,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life ?? 0.9"
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 420.0 + v.particle_random_1 * 360.0) * (v.radius ?? 1.2) * (0.55 + v.particle_random_2 * 0.45)",
          "v.particle_age * (2.2 + v.particle_random_3)",
          "math.sin(v.particle_age * 420.0 + v.particle_random_1 * 360.0) * (v.radius ?? 1.2) * (0.55 + v.particle_random_2 * 0.45)"
        ],
        "rotation": "v.particle_age * 420.0 + v.particle_random_1 * 360.0"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 * v.sz",
          "0.35 * v.sz"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.8) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), 0.8) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.8) * 1.0",
          "math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
