{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_bolt",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/bolt"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.24"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * 0.6",
          "(v.len ?? 6.0) * 0.5"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "math.floor(v.particle_random_3 * 3.99) * 64",
            0
          ],
          "uv_size": [
            64,
            256
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x ?? 0",
            "v.dir.y ?? 0",
            "v.dir.z ?? 1"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.45) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 0.95), 0.45) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 0.5), 0.45) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime) * (math.mod(math.floor(v.particle_age * 40.0), 2) == 0 ? 1.0 : 0.45)"
        ]
      }
    }
  }
}
