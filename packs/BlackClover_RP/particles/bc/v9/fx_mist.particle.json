{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_mist",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/dust"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(10 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.7 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.2 + v.particle_random_1 * 0.9"
      },
      "minecraft:particle_initial_speed": "0.5 + v.particle_random_2 * 0.6",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.15,
          0
        ],
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.6 + v.particle_age / v.particle_lifetime * 0.9) * v.sc",
          "(0.6 + v.particle_age / v.particle_lifetime * 0.9) * v.sc"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.85) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), 0.85) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.85) * 1.0",
          "0.28 * math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
