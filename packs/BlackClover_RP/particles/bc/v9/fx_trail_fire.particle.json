{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_trail_fire",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/fire"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.fk ?? 0) == 1 ? 45 : 0",
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 0
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + v.particle_random_1 * 0.25"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          2.0,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.22 + v.particle_random_3 * 0.15) * (v.hs ?? 1.0)",
          "(0.22 + v.particle_random_3 * 0.15) * (v.hs ?? 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              0,
              64
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_age / v.particle_lifetime < 0.3 ? math.lerp(1.0, (v.color.r ?? 1.0), v.particle_age / v.particle_lifetime / 0.3) : math.lerp((v.color.r ?? 1.0), 0.3, (v.particle_age / v.particle_lifetime - 0.3) / 0.7))",
          "(v.particle_age / v.particle_lifetime < 0.3 ? math.lerp(0.95, (v.color.g ?? 0.55), v.particle_age / v.particle_lifetime / 0.3) : math.lerp((v.color.g ?? 0.55), 0.03, (v.particle_age / v.particle_lifetime - 0.3) / 0.7))",
          "(v.particle_age / v.particle_lifetime < 0.3 ? math.lerp(0.75, (v.color.b ?? 0.15), v.particle_age / v.particle_lifetime / 0.3) : math.lerp((v.color.b ?? 0.15), 0.0, (v.particle_age / v.particle_lifetime - 0.3) / 0.7))",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.12,
        "direction": "outwards",
        "surface_only": false
      }
    }
  }
}
