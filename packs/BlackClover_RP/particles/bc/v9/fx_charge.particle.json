{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_charge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/soft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * (0.15 + v.particle_age / v.particle_lifetime * 1.05) * (1.0 + math.sin(v.particle_age * 2200.0) * 0.12)",
          "v.sz * (0.15 + v.particle_age / v.particle_lifetime * 1.05) * (1.0 + math.sin(v.particle_age * 2200.0) * 0.12)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 1.5, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 1.5, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 1.5, 1.0)) * 1.0",
          "math.min(v.particle_age * 8.0, 1.0)"
        ]
      }
    }
  }
}
