{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_trail_void",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bc/v9/smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.fk ?? 0) == 7 ? 28 : 0",
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 0
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_initial_speed": 0.3,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.2,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.25 + v.particle_age / v.particle_lifetime * 0.35) * (v.hs ?? 1.0)",
          "(0.25 + v.particle_age / v.particle_lifetime * 0.35) * (v.hs ?? 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              0,
              64
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.tr ?? 0.3) * 0.2",
          "(v.tg ?? 0.1) * 0.2",
          "(v.tb ?? 0.4) * 0.2",
          "0.8 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.12,
        "direction": "outwards",
        "surface_only": false
      }
    }
  }
}
