{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bc/v9/smoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(9 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.1 + v.particle_random_1 * 1.0"
      },
      "minecraft:particle_initial_speed": "(0.6 + v.particle_random_2 * 1.4) * v.sc",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.7,
          0
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.45 + v.particle_age / v.particle_lifetime * 1.1) * v.sc",
          "(0.45 + v.particle_age / v.particle_lifetime * 1.1) * v.sc"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              0,
              64
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 0.22) * 1.0",
          "(v.color.g ?? 0.21) * 1.0",
          "(v.color.b ?? 0.23) * 1.0",
          "0.6 * math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
