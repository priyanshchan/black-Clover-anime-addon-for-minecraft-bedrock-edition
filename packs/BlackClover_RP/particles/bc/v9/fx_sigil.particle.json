{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_sigil",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/sigil"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.9"
      },
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 90
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * (v.particle_age / v.particle_lifetime < 0.12 ? (v.particle_age / v.particle_lifetime / 0.12) * 1.12 : 1.12 - math.min((v.particle_age / v.particle_lifetime - 0.12) * 1.5, 0.12))",
          "v.sz * (v.particle_age / v.particle_lifetime < 0.12 ? (v.particle_age / v.particle_lifetime / 0.12) * 1.12 : 1.12 - math.min((v.particle_age / v.particle_lifetime - 0.12) * 1.5, 0.12))"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x ?? 0",
            "v.dir.y ?? 0",
            "v.dir.z ?? 1"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.85) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), 0.85) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.85) * 1.0",
          "math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0) * (0.85 + math.sin(v.particle_age * 1500.0) * 0.15)"
        ]
      }
    }
  }
}
