{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_trail",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/soft"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 80
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": 0
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.28 + v.particle_random_1 * 0.12"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.hs ?? 1.0) * 0.32 * (1.0 - v.particle_age / v.particle_lifetime)",
          "(v.hs ?? 1.0) * 0.32 * (1.0 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, v.tr ?? 1.0, math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0))",
          "math.lerp(1.0, v.tg ?? 1.0, math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0))",
          "math.lerp(1.0, v.tb ?? 1.0, math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0))",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.12,
        "direction": "outwards",
        "surface_only": false
      }
    }
  }
}
