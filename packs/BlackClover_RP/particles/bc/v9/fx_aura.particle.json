{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/soft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 30,
        "max_particles": 50
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life ?? 1.0"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "0.55",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ],
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_1 * 0.5"
      },
      "minecraft:particle_initial_speed": "0.9 + v.particle_random_2 * 1.2",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.09 + v.particle_random_3 * 0.07",
          "0.09 + v.particle_random_3 * 0.07"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.5) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), 0.5) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.5) * 1.0",
          "math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0) * (0.6 + math.sin(v.particle_age * 1400.0 + v.particle_random_4 * 360.0) * 0.4)"
        ]
      }
    }
  }
}
