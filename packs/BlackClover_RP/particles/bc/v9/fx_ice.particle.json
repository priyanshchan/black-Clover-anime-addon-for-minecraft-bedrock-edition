{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_ice",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/shard"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(16 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_1 * 0.5"
      },
      "minecraft:particle_initial_speed": "(4.0 + v.particle_random_2 * 6.0) * math.sqrt(v.sc)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -12,
          0
        ],
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 3.0,
        "coefficient_of_restitution": 0.3,
        "collision_radius": 0.05
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-500, 500)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + v.particle_random_3 * 0.1",
          "0.1 + v.particle_random_3 * 0.1"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 0.7), 0.3 + v.particle_age / v.particle_lifetime * 0.7) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 0.9), 0.3 + v.particle_age / v.particle_lifetime * 0.7) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.3 + v.particle_age / v.particle_lifetime * 0.7) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
