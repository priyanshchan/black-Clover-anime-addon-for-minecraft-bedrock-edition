{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_leaf",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/bc/v9/leaf"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(12 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.4 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.5 + v.particle_random_1 * 1.0"
      },
      "minecraft:particle_initial_speed": "(2.5 + v.particle_random_2 * 3.5) * math.sqrt(v.sc)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -2.2,
          0
        ],
        "linear_drag_coefficient": 2.6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-320, 320)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + v.particle_random_3 * 0.07",
          "0.1 + v.particle_random_3 * 0.07"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 0.35) * (0.75 + v.particle_random_4 * 0.25)",
          "(v.color.g ?? 0.75) * (0.75 + v.particle_random_4 * 0.25)",
          "(v.color.b ?? 0.3) * (0.75 + v.particle_random_4 * 0.25)",
          "1.0"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
