{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_flake",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/flake"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(12 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.7 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.4 + v.particle_random_1 * 1.0"
      },
      "minecraft:particle_initial_speed": "0.8 + v.particle_random_2 * 1.4",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -0.9,
          0
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-140, 140)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 + v.particle_random_3 * 0.05",
          "0.06 + v.particle_random_3 * 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 0.8), 0.6) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 0.95), 0.6) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.6) * 1.0",
          "math.clamp(v.particle_age * 6.0, 0.0, 1.0) * math.clamp((v.particle_lifetime - v.particle_age) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
