{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_converge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/streak"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life ?? 0.5"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.radius ?? 2.0",
        "direction": "inwards",
        "surface_only": true
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.4"
      },
      "minecraft:particle_initial_speed": "(v.radius ?? 2.0) / 0.42",
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.05",
          "0.3 * (0.4 + v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), v.particle_age / v.particle_lifetime) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), v.particle_age / v.particle_lifetime) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), v.particle_age / v.particle_lifetime) * 1.0",
          "math.min(v.particle_age * 10.0, 1.0)"
        ]
      }
    }
  }
}
