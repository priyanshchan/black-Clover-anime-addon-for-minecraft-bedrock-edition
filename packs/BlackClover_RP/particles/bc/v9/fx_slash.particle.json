{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_slash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/slash"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.26"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.rot ?? math.random(-40, 40)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * (0.7 + 0.3 * math.min(v.particle_age * 12.0, 1.0))",
          "v.sz * 0.5 * (0.7 + 0.3 * math.min(v.particle_age * 12.0, 1.0))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "math.pow((1.0 - v.particle_age / v.particle_lifetime), 1.3)"
        ]
      }
    }
  }
}
