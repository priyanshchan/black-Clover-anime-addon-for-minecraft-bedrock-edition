{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/streak"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 90,
        "max_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "0.25"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "(v.radius ?? 0.6) * 0.6",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": [
          0,
          1,
          0
        ],
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + v.particle_random_1 * 0.3"
      },
      "minecraft:particle_initial_speed": "12.0 + v.particle_random_2 * 8.0",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 * v.sz",
          "0.8 * v.sz * (1.0 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.0, 1.0)) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
