{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_water",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/drop"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(24 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * v.sc",
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.2, 1.4)",
          "math.random(-1, 1)"
        ],
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + v.particle_random_1 * 0.5"
      },
      "minecraft:particle_initial_speed": "(3.5 + v.particle_random_2 * 5.0) * math.sqrt(v.sc)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -16,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 4.0,
        "coefficient_of_restitution": 0.15,
        "collision_radius": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 + v.particle_random_3 * 0.06",
          "0.08 + v.particle_random_3 * 0.06"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 0.35), 0.7) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 0.65), 0.7) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.7) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
