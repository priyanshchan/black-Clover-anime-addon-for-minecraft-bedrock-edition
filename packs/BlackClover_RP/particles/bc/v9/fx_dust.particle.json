{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/bc/v9/dust"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(22 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "0.35 * v.sc",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + v.particle_random_1 * 0.6"
      },
      "minecraft:particle_initial_speed": "(4.0 + v.particle_random_2 * 5.0) * math.sqrt(v.sc)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.35,
          0
        ],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.35 + v.particle_age / v.particle_lifetime * 0.9) * math.sqrt(v.sc)",
          "(0.35 + v.particle_age / v.particle_lifetime * 0.9) * math.sqrt(v.sc)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 0.55) * 1.0",
          "(v.color.g ?? 0.5) * 1.0",
          "(v.color.b ?? 0.44) * 1.0",
          "0.65 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
