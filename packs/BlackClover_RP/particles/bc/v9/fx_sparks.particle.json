{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/streak"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(18 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.2 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + v.particle_random_1 * 0.4"
      },
      "minecraft:particle_initial_speed": "(5.0 + v.particle_random_2 * 9.0) * math.sqrt(v.sc)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -11,
          0
        ],
        "linear_drag_coefficient": 1.3
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 2.0,
        "coefficient_of_restitution": 0.35,
        "collision_radius": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.045 * math.sqrt(v.sc)",
          "0.26 * math.sqrt(v.sc) * (1.0 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.5, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.5, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.5, 1.0)) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
