{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/flare"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.3"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * 2.4 * (0.35 + 0.9 * math.clamp(v.particle_age * 14.0, 0.0, 1.0)) * (1.0 - v.particle_age / v.particle_lifetime * 0.45)",
          "v.sz * 2.4 * (0.35 + 0.9 * math.clamp(v.particle_age * 14.0, 0.0, 1.0)) * (1.0 - v.particle_age / v.particle_lifetime * 0.45)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.2, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.2, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 2.2, 1.0)) * 1.0",
          "math.pow((1.0 - v.particle_age / v.particle_lifetime), 1.6)"
        ]
      }
    }
  }
}
