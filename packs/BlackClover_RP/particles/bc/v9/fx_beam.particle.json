{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/beam"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(4, (v.len ?? 4.0) * 5.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.32"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.dir.x ?? 0) * (v.len ?? 4.0) * v.particle_random_1",
          "(v.dir.y ?? 0) * (v.len ?? 4.0) * v.particle_random_1",
          "(v.dir.z ?? 1) * (v.len ?? 4.0) * v.particle_random_1"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.sz * 1.0 * (1.0 - v.particle_age / v.particle_lifetime * 0.6) * (0.85 + math.sin(v.particle_age * 3000.0 + v.particle_random_2 * 360.0) * 0.15)",
          "0.45"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x ?? 0",
            "v.dir.y ?? 0",
            "v.dir.z ?? 1"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.6) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), 0.6) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), 0.6) * 1.0",
          "math.pow((1.0 - v.particle_age / v.particle_lifetime), 1.2)"
        ]
      }
    }
  }
}
