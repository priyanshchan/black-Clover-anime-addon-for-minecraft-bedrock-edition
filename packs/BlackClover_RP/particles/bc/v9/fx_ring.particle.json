{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/ring"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.42"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.radius ?? 3.0) * (1.0 - math.pow(1.0 - v.particle_age / v.particle_lifetime, 3.0))",
          "(v.radius ?? 3.0) * (1.0 - math.pow(1.0 - v.particle_age / v.particle_lifetime, 3.0))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 3.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 3.0, 1.0)) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 1.0), math.min(v.particle_age / v.particle_lifetime * 3.0, 1.0)) * 1.0",
          "math.pow((1.0 - v.particle_age / v.particle_lifetime), 1.4)"
        ]
      }
    }
  }
}
