{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bc:fx_embers",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/bc/v9/soft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.sc = v.scale ?? 1.0; v.sz = v.size ?? 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.round(14 * v.sc)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.6 * v.sc",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.0 + v.particle_random_1 * 1.3"
      },
      "minecraft:particle_initial_speed": "0.6 + v.particle_random_2 * 1.6",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.1,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + v.particle_random_3 * 0.05",
          "0.07 + v.particle_random_3 * 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1.0, (v.color.r ?? 1.0), 0.4 + v.particle_age / v.particle_lifetime * 0.6) * 1.0",
          "math.lerp(1.0, (v.color.g ?? 0.55), 0.4 + v.particle_age / v.particle_lifetime * 0.6) * 1.0",
          "math.lerp(1.0, (v.color.b ?? 0.15), 0.4 + v.particle_age / v.particle_lifetime * 0.6) * 1.0",
          "(1.0 - v.particle_age / v.particle_lifetime) * (0.55 + math.sin(v.particle_age * 1100.0 + v.particle_random_4 * 360.0) * 0.45)"
        ]
      }
    }
  }
}
