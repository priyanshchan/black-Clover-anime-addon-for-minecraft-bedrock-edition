        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              0,
              32
            ],
            "frames_per_second": 8,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
