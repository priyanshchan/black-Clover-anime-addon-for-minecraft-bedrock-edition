      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              1.0,
              0.941,
              0.69,
              1.0
            ],
            "0.35": [
              1.0,
              0.478,
              0.102,
              1.0
            ],
            "1.0": [
              0.376,
              0.063,
              0.016,
              0.0
            ]
