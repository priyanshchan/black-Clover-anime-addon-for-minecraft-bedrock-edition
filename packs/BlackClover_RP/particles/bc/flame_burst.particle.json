      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 * (0.6 + v.particle_random_1 * 0.8)"
      },
      "minecraft:particle_initial_speed": "(8) * v.sc * (0.5 + v.particle_random_2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
