      },
      "bc:look_2": {
        "set_property": {
          "bc:look": 2
        }
      },
      "bc:look_3": {
        "set_property": {
          "bc:look": 3
        }
      },
      "bc:look_4": {
        "set_property": {
          "bc:look": 4
        }
      },
      "bc:look_5": {
        "set_property": {
          "bc:look": 5
        }
      }
    }
